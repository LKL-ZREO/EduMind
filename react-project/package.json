{
  "name": "edumind-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all2 type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --build",
    "lint": "npm-run-all2 lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "npm-run-all2 lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:check": "npm-run-all2 format:check type-check lint test build-only"
  },
  "dependencies": {
    "@stomp/stompjs": "7.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "antd": "6.5.3",
    "axios": "1.19.0",
    "dayjs": "1.11.18",
    "dompurify": "3.4.14",
    "echarts": "6.1.0",
    "highlight.js": "11.11.1",
    "katex": "0.17.0",
    "marked": "18.0.7",
    "marked-highlight": "2.2.4",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "5.0.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/katex": "0.16.7",
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
