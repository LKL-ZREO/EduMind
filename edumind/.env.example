# Copy this file to .env and fill every REQUIRED value before deployment.
# Keep .env outside version control and restrict it to the deployment account.

# ==================== Public endpoint ====================
DOMAIN=
CERTBOT_EMAIL=
# Use true only while testing certificate issuance to avoid Let's Encrypt rate limits.
CERTBOT_STAGING=false

# ==================== Database and encryption ====================
DB_NAME=postgres
DB_USER=postgres
# REQUIRED: use a unique password with at least 16 characters.
DB_PASS=
# REQUIRED: openssl rand -base64 48
LIVE_SESSION_TOKEN_SECRET=
# REQUIRED: openssl rand -base64 32
ENCRYPT_AES_KEY=
BACKUP_RETENTION_DAYS=7

# ==================== LLM ====================
# REQUIRED: DeepSeek credential for text generation and Agent calls.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEXT_MODEL=deepseek-v4-flash
# REQUIRED: Moonshot credential for image and visual PDF understanding.
LLM_VISION_BASE_URL=https://api.moonshot.cn/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=kimi-k2.5
LLM_VISION_TEMPERATURE=1.0

AI_STRUCTURED_MAX_ATTEMPTS=2
AI_STRUCTURED_MAX_RESPONSE_CHARS=100000

# ==================== Agent memory ====================
AGENT_MEMORY_MAX_TOKENS=12000
AGENT_MEMORY_TOKEN_ESTIMATOR_MODEL=gpt-4o-mini
AGENT_MEMORY_MAX_ACTIVE_SESSIONS=10000
AGENT_MEMORY_EXPIRE_AFTER_ACCESS=PT2H

# ==================== Optional Helicone telemetry ====================
HELICONE_ENABLED=false
HELICONE_API_KEY=
HELICONE_GATEWAY_URL=https://gateway.helicone.ai/v1
HELICONE_OMIT_CONTENT=true
HELICONE_ENVIRONMENT=production

# ==================== MCP ====================
# REQUIRED: openssl rand -base64 48
MCP_API_KEY=

# ==================== OneBot / NapCat ====================
# Disabled by default. If enabled, NapCat should listen on host port 3001.
ONEBOT_WS_ENABLED=false
ONEBOT_WS_URL=ws://host.docker.internal:3001
ONEBOT_WS_TOKEN=

# Comma-separated hosts from which the backend may download visual assets.
VISION_ALLOWED_HOSTS=multimedia.nt.qq.com.cn

# ==================== File and model storage ====================
# local stores uploads in a Docker volume; s3 uses the bundled MinIO service.
STORAGE_TYPE=local
S3_REGION=us-east-1
S3_BUCKET=homework-files
# REQUIRED even in local mode because the bundled MinIO container is started.
S3_ACCESS_KEY=
# REQUIRED: at least 16 characters.
S3_SECRET_KEY=
S3_PATH_STYLE=true

# Host directory containing onnx/model.onnx and tokenizer files.
RERANKER_MODEL_DIR=./models/bge-reranker-base

# 512-dimensional embedding model. The ONNX file is under onnx/ in this repository.
EMBEDDING_MODEL_REPOSITORY=Xenova/bge-small-zh-v1.5
EMBEDDING_MODEL_REVISION=75c43b069aac4d136ba6bc1122f995fedcfd2781
EMBEDDING_MODEL_ONNX_PATH=onnx/model.onnx
# Comma-separated download endpoints, tried from left to right.
EMBEDDING_MODEL_BASE_URLS=https://hf-mirror.com,https://huggingface.co

# ==================== Observability ====================
ENABLE_OBSERVABILITY=false
GRAFANA_USER=admin
# REQUIRED even when observability is disabled, so enabling it never uses a default password.
GRAFANA_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ==================== Local-only published ports ====================
# These bind to 127.0.0.1 and are not exposed publicly.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== Deployment metadata and logging ====================
IMAGE_TAG=local
GIT_COMMIT=unknown
# Defaults are pinned for reproducible rebuilds; update these values deliberately.
MINIO_IMAGE_TAG=RELEASE.2025-07-23T15-54-02Z
CERTBOT_IMAGE_TAG=v5.7.0
# Override with a trusted regional mirror if Maven Central is slow from the server.
MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
