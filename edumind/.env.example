# ==================== 本地开发环境变量模板 ====================
# 复制此文件为 .env 后填入真实值
# cp .env.example .env
#
# .env 文件已加入 .gitignore，不会被提交到 Git

# 域名（用于 Let's Encrypt SSL 证书）
DOMAIN=localhost
# 证书通知邮箱
CERTBOT_EMAIL=admin@example.com

# 数据库密码
DB_PASS=change-me-to-a-strong-password

# 数据库用户（可选，默认为 postgres）
DB_USER=postgres

# 学生课堂范围令牌密钥（openssl rand -base64 32）
LIVE_SESSION_TOKEN_SECRET=change-me-to-a-random-string-at-least-32-bytes

# PII 加密密钥（openssl rand -base64 32）
ENCRYPT_AES_KEY=change-me-to-a-random-base64-string-at-least-32-bytes

# ==================== LLM 直连配置 ====================
# LLM API Key（必填，去对应平台申请）
# DeepSeek: https://platform.deepseek.com → API Keys
# Kimi: https://platform.moonshot.cn → API Keys
LLM_API_KEY=change-me
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5
LLM_TEXT_MODEL=kimi-k2.5
LLM_VISION_BASE_URL=https://api.moonshot.cn/v1
LLM_VISION_API_KEY=change-me
LLM_VISION_MODEL=kimi-k2.5
LLM_VISION_TEMPERATURE=1.0

# LLM 模型名（可选）
# DeepSeek 推荐: deepseek-v4-flash (快) / deepseek-v4-pro (强)
# Kimi 推荐: kimi-k2-0701-preview
# LLM_MODEL=deepseek-v4-pro
# LLM_TEXT_MODEL=deepseek-v4-pro
# LLM_VISION_MODEL=your-vision-model-name
# LLM_VISION_BASE_URL=https://api.example.com/v1
# LLM_VISION_API_KEY=change-me
# LLM_VISION_TEMPERATURE=1.0

# Comma-separated hosts from which the backend may download visual assets.
# VISION_ALLOWED_HOSTS=multimedia.nt.qq.com.cn
# Exact trusted CDN hosts allowed to resolve through proxy/TUN Fake-IP DNS.
# VISION_TRUSTED_PRIVATE_RESOLUTION_HOSTS=multimedia.nt.qq.com.cn

# LLM API 地址（可选，按供应商选择）
# DeepSeek: https://api.deepseek.com
# Kimi: https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.deepseek.com

# LLM 后端模式（可选，默认 built-in=直连，openclaw=旧网关）
# EDUMIND_LLM_BACKEND=built-in

# ==================== Agent 工作记忆 ====================
# 每个用户会话保留的上下文 Token 上限；需为模型输出和工具调用预留空间。
AGENT_MEMORY_MAX_TOKENS=12000
# 仅用于本地估算 Token，不会改变实际调用的 LLM。
AGENT_MEMORY_TOKEN_ESTIMATOR_MODEL=gpt-4o-mini
# 单实例最多缓存的活跃会话；超出后从本地淘汰，持久化数据不受影响。
AGENT_MEMORY_MAX_ACTIVE_SESSIONS=10000
AGENT_MEMORY_EXPIRE_AFTER_ACCESS=PT2H

# ==================== Helicone 被动观测（可选） ====================
# 默认关闭；开启后统计模型请求、Token、成本和延迟，不启用重试、缓存或限额。
HELICONE_ENABLED=false
HELICONE_API_KEY=
HELICONE_GATEWAY_URL=https://gateway.helicone.ai/v1
# 教育数据默认不在 Helicone 中长期保存请求和回答正文。
HELICONE_OMIT_CONTENT=true
HELICONE_ENVIRONMENT=dev

# OpenClaw AI Gateway（仅 EDUMIND_LLM_BACKEND=openclaw 时需要）
# OPENCLAW_API_KEY=change-me
# OPENCLAW_BASE_URL=http://localhost:18789/v1

# OneBot QQ Bot Token (HTTP 发消息)
ONEBOT_TOKEN=change-me

# OneBot WebSocket 连接 Token（收消息，NapCat 的 access_token）
ONEBOT_WS_TOKEN=KlR82ViIJ.hbgENa

# MCP 服务间认证密钥
MCP_API_KEY=change-me

# Reranker ONNX 模型目录（可选，未安装模型时自动回退）
AI_MODEL_DIR=

# ==================== 文件存储 ====================
# local=本地磁盘（默认），s3=S3对象存储
STORAGE_TYPE=local

# S3 对象存储（仅 STORAGE_TYPE=s3 时需要）
# 本地开发：MinIO（docker-compose 自带，endpoint=http://localhost:9000）
# 生产环境：阿里云 OSS S3 兼容端点（endpoint=https://oss-cn-hangzhou.aliyuncs.com）
S3_ENDPOINT=http://localhost:9000
# Compose containers use their internal DNS name instead of the host endpoint.
S3_DOCKER_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=homework-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
